{
  "name": "typescript-node",
  "version": "2.1.0",
  "description": "TypeScript template for backend applications.",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Talento90/typescript-node.git"
  },
  "author": "Talento90",
  "keywords": [
    "typescript",
    "nodejs",
    "backend"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "build:watch": "rm -rf dist && tsc -w",
    "clean": "rm -rf node_modules coverage dist .nyc_output",
    "coverage": "nyc --exclude dist/test --reporter=html npm run test:all",
    "lint": "tslint 'src/**/*.ts' 'test/**/*.test.ts'",
    "start": "node dist/src/index.js",
    "start:dev": "tsc-watch --onSuccess 'node --inspect=0.0.0.0:5858 dist/src/index.js'",
    "test": "npm run build && mocha --exit --recursive dist/test/unit",
    "test:integration": "npm run build && mocha --exit --recursive dist/test/integration",
    "test:all": "npm run build && mocha --exit --recursive dist/test"
  },
  "dependencies": {
    "async": "^3.2.2",
    "bcryptjs": "^2.4.3",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.0",
    "knex": "^2.4.0",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.2.1",
    "koa-helmet": "^5.1.0",
    "koa-router": "^7.4.0",
    "moment": "^2.29.4",
    "mysql2": "^3.23.1",
    "pino": "^5.13.3"
  },
  "devDependencies": {
    "@types/async": "^3.0.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/chai": "^4.2.3",
    "@types/joi": "^14.3.3",
    "@types/jsonwebtoken": "^8.3.3",
    "@types/knex": "^0.16.1",
    "@types/koa": "^2.0.49",
    "@types/koa-bodyparser": "^4.3.0",
    "@types/koa-helmet": "^3.1.2",
    "@types/koa-router": "^7.0.42",
    "@types/mocha": "^5.2.7",
    "@types/node": "^12.7.5",
    "@types/pino": "^5.8.10",
    "@types/sinon": "^7.0.13",
    "@types/supertest": "^2.0.8",
    "chai": "^4.2.0",
    "husky": "^3.0.5",
    "mocha": "^6.2.0",
    "nyc": "^14.1.1",
    "prettier": "^1.18.2",
    "sinon": "^7.4.2",
    "supertest": "^4.0.2",
    "tsc-watch": "^3.0.1",
    "tslint": "^5.20.0",
    "tslint-config-prettier": "^1.18.0",
    "tslint-plugin-prettier": "^2.0.1",
    "typescript": "^3.6.3"
  },
  "engines": {
    "node": ">=12.10.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint && npm test"
    }
  },
  "overrides": {
    "@babel/traverse": "7.23.2",
    "form-data": "2.5.6",
    "handlebars": "4.7.10",
    "minimist": "0.2.4",
    "ansi-regex": "3.0.1",
    "brace-expansion": "1.1.21",
    "braces": "3.0.3",
    "cross-spawn": "6.0.6",
    "decode-uri-component": "0.5.1",
    "get-func-name": "2.0.1",
    "js-yaml": "3.15.2",
    "jws": "3.2.3",
    "kind-of": "6.0.3",
    "lodash": "4.18.1",
    "minimatch": "3.1.4",
    "path-to-regexp": "1.9.0",
    "pathval": "1.1.1",
    "qs": "6.16.1",
    "semver": "5.7.2",
    "urijs": "1.19.11",
    "y18n": "4.0.1",
    "cookiejar": "2.1.4",
    "hosted-git-info": "2.8.9",
    "micromatch": "4.0.8",
    "path-parse": "1.0.7",
    "uuid": "11.1.1",
    "yargs-parser": "13.1.2",
    "diff": "3.5.1"
  }
}